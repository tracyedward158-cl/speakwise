{
  "name": "speakwise-mp",
  "version": "1.0.0",
  "private": true,
  "description": "SpeakWise 琢音平台 — 微信小程序端（Taro 4 + React）",
  "templateInfo": {
    "name": "speakwise",
    "typescript": false
  },
  "scripts": {
    "build:weapp": "taro build --type weapp && node scripts/check-dist.mjs",
    "dev:weapp": "npm run build:weapp -- --watch",
    "sync:core": "node scripts/sync-core.mjs",
    "check:core": "node scripts/check-core.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "babel-preset-taro": "4.2.1",
    "postcss": "^8.4.18",
    "webpack": "^5.91.0"
  }
}
